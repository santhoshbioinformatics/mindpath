# ─────────────────────────────────────────────────────────────────────────────
# MindPath API — Environment Variables
# Copy this file to .env and fill in values before running
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:8081,exp://192.168.1.100:8081

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://mindpath:mindpath_dev@localhost:5432/mindpath"

# ── Authentication ────────────────────────────────────────────────────────────
# Must be at least 32 characters — use: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-minimum-32-characters-replace-this
JWT_REFRESH_SECRET=your-refresh-secret-minimum-32-characters-replace-this
JWT_EXPIRES_IN=7d

# ── AI ────────────────────────────────────────────────────────────────────────
# Claude API key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60000   # Window in ms (1 minute)
THROTTLE_LIMIT=60    # Max requests per window per IP

# ── Push Notifications ────────────────────────────────────────────────────────
# Expo push notification access token (expo.dev/accounts/...)
EXPO_ACCESS_TOKEN=

# For Firebase Cloud Messaging (Android backup)
# FIREBASE_SERVER_KEY=

# ── Email (for magic links) ───────────────────────────────────────────────────
# Resend, SendGrid, or any SMTP provider
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_...
FROM_EMAIL=noreply@mindpath.app

# ── File Storage (for voice journals) ─────────────────────────────────────────
# AWS S3 or Cloudflare R2 (S3-compatible)
S3_BUCKET=mindpath-voice-journals
S3_REGION=us-east-1
S3_ENDPOINT=                     # Leave empty for AWS S3; set for R2/MinIO
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Monitoring (optional) ─────────────────────────────────────────────────────
# Sentry DSN for error tracking
SENTRY_DSN=

# ── Feature flags (optional) ──────────────────────────────────────────────────
ENABLE_WEARABLE_SYNC=false
ENABLE_VOICE_JOURNALS=true
ENABLE_AI_INSIGHTS=true
ENABLE_CORRELATION_DETECTION=true
